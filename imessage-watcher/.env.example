# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# claude-haiku-5-5 is fast and cheap for triage; switch to claude-sonnet-5-5 for sharper replies.
MODEL=claude-haiku-5-5

# Seconds a conversation must be quiet before it gets analyzed (batches rapid-fire texts).
QUIET_SECONDS=20
# How many earlier messages to include as context.
CONTEXT_MESSAGES=20

# macOS notifications
NOTIFY=true
NOTIFY_MIN_URGENCY=4
# Categories that never notify (comma-separated)
QUIET_CATEGORIES=spam

# Analyze group chats too?
INCLUDE_GROUPS=false

# Numbers/emails to skip entirely (comma-separated), e.g. 2FA short codes
IGNORE_HANDLES=

# Optional: POST every analysis as JSON here (Apps Script web app for a Google Sheet, Slack, Zapier...)
WEBHOOK_URL=

# Set true to test the pipeline without calling the API
DRY_RUN=false
