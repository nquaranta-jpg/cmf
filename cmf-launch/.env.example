# Copy to .env for local dev. All PUBLIC_* vars are inlined at build time.

# GoHighLevel portal URLs for the auth buttons.
# TODO: set these before launch; buttons fall back to "#" when unset.
PUBLIC_LOGIN_URL=
PUBLIC_SIGNUP_URL=

# GoHighLevel inbound webhook that receives the opt-in form JSON.
# TODO: set this before launch; the form shows an error if it is unset.
PUBLIC_FORM_WEBHOOK_URL=

# Analytics. Each renders nothing when unset.
PUBLIC_GTM_ID=
PUBLIC_META_PIXEL_ID=
