---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  meta,
  hero,
  optIn,
  whatYoullLearn,
  whoThisIsFor,
  trainer,
  closer,
} from "../copy/free-training";

// Copy rule: no carrier names anywhere on this page (build note 2).

// TODO: GoHighLevel inbound webhook URL. The form refuses to submit and shows
// the inline error while this is unset.
const webhookUrl = import.meta.env.PUBLIC_FORM_WEBHOOK_URL || "";
const errors = optIn.form.errors;
---

<BaseLayout title={meta.title} description={meta.description}>
  {/* ================================================================
      HERO
      ================================================================ */}
  <section class="band hero-atmos overflow-hidden">
    <div class="mx-auto max-w-4xl px-4 pb-20 pt-16 text-center sm:px-6 sm:pb-28 sm:pt-24">
      <p class="eyebrow justify-center">{hero.eyebrow}</p>
      <h1
        class="display mt-7 text-[2.1rem] text-brand-text sm:text-[3.4rem] md:text-[3.9rem]"
      >
        {hero.h1}
      </h1>
      <p class="mx-auto mt-7 max-w-2xl text-lg leading-relaxed text-brand-text/65">
        {hero.body}
      </p>
      <p class="mt-8 text-base font-extrabold tracking-tight text-brand-text sm:text-lg">
        {hero.accessLine}
      </p>

      <div class="mt-10 flex justify-center">
        <div class="card flex items-center gap-4 px-6 py-4 text-left">
          {/* TODO: trainer headshot. Swap this placeholder block for a real
              photo of Nicholas Quaranta with alt text "Nicholas Quaranta,
              founder of Crown Merchant Financial". No stock photos. */}
          <div
            class="grid h-12 w-12 shrink-0 place-content-center rounded-full bg-gradient-to-b from-[var(--gold-bright)] to-[var(--brand-accent)] text-base font-black text-brand-bg"
            aria-hidden="true"
          >
            NQ
          </div>
          <div>
            <p class="text-sm font-bold text-brand-text sm:text-base">{hero.hostedBy}</p>
            <p class="mt-0.5 text-xs text-brand-text/55 sm:text-sm">
              {hero.hostCredentials}
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ================================================================
      OPT-IN FORM
      ================================================================ */}
  <section id="register" class="band-alt">
    <div class="mx-auto max-w-2xl px-4 py-20 sm:px-6 sm:py-28">
      <h2 class="display text-center text-3xl text-brand-text sm:text-[2.75rem] sm:leading-[1.05]">
        {optIn.heading}
      </h2>
      <p class="mt-5 text-center text-lg text-brand-text/65">
        {optIn.subhead}
      </p>

      <form
        id="opt-in-form"
        class="card card-gold mt-10 p-6 sm:p-9"
        novalidate
        data-webhook-url={webhookUrl}
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="firstName" class="mb-1.5 block text-sm font-semibold text-brand-text">
              {optIn.form.firstName}
            </label>
            <input
              type="text"
              id="firstName"
              name="firstName"
              autocomplete="given-name"
              required
              class="input"
            />
            <p class="field-error mt-1.5 hidden text-sm text-red-400" data-for="firstName"></p>
          </div>
          <div>
            <label for="lastName" class="mb-1.5 block text-sm font-semibold text-brand-text">
              {optIn.form.lastName}
            </label>
            <input
              type="text"
              id="lastName"
              name="lastName"
              autocomplete="family-name"
              required
              class="input"
            />
            <p class="field-error mt-1.5 hidden text-sm text-red-400" data-for="lastName"></p>
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-semibold text-brand-text">
              {optIn.form.email}
            </label>
            <input
              type="email"
              id="email"
              name="email"
              autocomplete="email"
              inputmode="email"
              required
              class="input"
            />
            <p class="field-error mt-1.5 hidden text-sm text-red-400" data-for="email"></p>
          </div>
          <div>
            <label for="mobile" class="mb-1.5 block text-sm font-semibold text-brand-text">
              {optIn.form.mobile}
            </label>
            <input
              type="tel"
              id="mobile"
              name="mobile"
              autocomplete="tel"
              inputmode="tel"
              required
              class="input"
            />
            <p class="field-error mt-1.5 hidden text-sm text-red-400" data-for="mobile"></p>
          </div>
        </div>

        {/* TCPA consent: unchecked by default, required to submit. The label
            is the exact drafted consent text from the copy doc; legal review
            required before launch (build note 1). */}
        <div class="mt-6">
          <label class="flex items-start gap-3">
            <input type="checkbox" id="consent" name="consent" required class="checkbox" />
            <span class="text-xs leading-relaxed text-brand-text/60">
              {optIn.form.consentLabel}
            </span>
          </label>
          <p class="field-error mt-1.5 hidden text-sm text-red-400" data-for="consent"></p>
        </div>

        <button type="submit" class="btn btn-primary mt-8 w-full py-4 text-lg disabled:cursor-not-allowed disabled:opacity-60">
          {optIn.form.submitLabel}
        </button>

        <p id="form-error" class="mt-4 hidden text-center text-sm text-red-400" role="alert"></p>

        <p class="mt-5 text-center text-sm text-brand-text/55">
          {optIn.form.postSubmitNote}
        </p>
      </form>
    </div>
  </section>

  {/* ================================================================
      WHAT YOU'LL LEARN - six numbered module cards (the numbering is
      the training outline, so it carries real sequence information).
      ================================================================ */}
  <section class="band">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow justify-center">{whatYoullLearn.eyebrow}</p>
        <h2 class="display mt-5 text-3xl text-brand-text sm:text-[2.75rem] sm:leading-[1.05]">
          {whatYoullLearn.heading}
        </h2>
        <p class="mt-5 text-lg leading-relaxed text-brand-text/65">
          {whatYoullLearn.intro}
        </p>
      </div>
      <ol class="mt-14 grid gap-5 md:grid-cols-2">
        {
          whatYoullLearn.modules.map((m, i) => (
            <li class="card card-hover relative overflow-hidden p-7 sm:p-8">
              <span
                class="display pointer-events-none absolute -right-2 -top-6 text-[7rem] tabular-nums"
                style="color: var(--accent-soft);"
                aria-hidden="true"
              >
                {String(i + 1).padStart(2, "0")}
              </span>
              <div class="relative">
                <p class="eyebrow eyebrow-left text-[0.65rem]">{m.label}</p>
                <h3 class="mt-3 max-w-[26rem] text-xl font-extrabold tracking-tight text-brand-text">
                  {m.title}
                </h3>
                <p class="mt-3 max-w-[28rem] leading-relaxed text-brand-text/65">{m.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  {/* ================================================================
      WHO THIS IS FOR - three agent-type cards.
      ================================================================ */}
  <section class="band-alt">
    <div class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow justify-center">{whoThisIsFor.eyebrow}</p>
        <h2 class="display mt-5 text-3xl text-brand-text sm:text-[2.75rem] sm:leading-[1.05]">
          {whoThisIsFor.heading}
        </h2>
      </div>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {
          whoThisIsFor.cards.map((card) => (
            <div class="card card-hover p-8">
              <h3 class="text-lg font-extrabold tracking-tight text-brand-accent">
                {card.title}
              </h3>
              <p class="mt-2 font-bold text-brand-text">{card.lead}</p>
              <p class="mt-3 leading-relaxed text-brand-text/65">{card.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ================================================================
      YOUR TRAINER
      ================================================================ */}
  <section class="band">
    <div class="mx-auto max-w-5xl px-4 py-20 sm:px-6 sm:py-28">
      <div class="grid items-center gap-10 md:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
        {/* TODO: trainer photo. Swap this placeholder panel for a real photo
            of Nicholas Quaranta (alt: "Nicholas Quaranta, founder of Crown
            Merchant Financial"). No stock photos. */}
        <div
          class="card relative mx-auto grid aspect-[4/5] w-full max-w-sm place-content-center overflow-hidden"
          aria-hidden="true"
        >
          <div
            class="absolute inset-0"
            style="background: radial-gradient(80% 60% at 50% 20%, var(--accent-soft), transparent 70%), radial-gradient(60% 50% at 80% 90%, color-mix(in srgb, var(--brand-accent-2) 18%, transparent), transparent 70%);"
          >
          </div>
          <span class="display relative text-7xl" style="color: var(--accent-glow);">NQ</span>
        </div>
        <div class="">
          <p class="eyebrow eyebrow-left">{trainer.eyebrow}</p>
          <h2 class="display mt-5 text-3xl text-brand-text sm:text-[2.5rem] sm:leading-[1.05]">
            {trainer.heading}
          </h2>
          {
            trainer.paragraphs.map((p) => (
              <p class="mt-6 leading-relaxed text-brand-text/70">{p}</p>
            ))
          }

          {/* Optional stat blocks slot - intentionally empty per the copy doc:
              "go here only when the numbers are real and defensible: personal
              production, agent count, persistency. Do not fabricate."
              When real figures exist, render StatCard components in a grid here. */}
        </div>
      </div>
    </div>
  </section>

  {/* ================================================================
      CLOSER - CTA anchors back up to the opt-in form.
      ================================================================ */}
  <section class="band-alt hero-atmos overflow-hidden">
    <div class="mx-auto max-w-3xl px-4 py-24 text-center sm:px-6 sm:py-32">
      <h2 class="display text-4xl text-brand-text sm:text-5xl">
        {closer.heading}
      </h2>
      <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-brand-text/65">
        {closer.body}
      </p>
      <div class="mt-10">
        <a href="#register" class="btn btn-primary btn-lg">{closer.ctaLabel}</a>
      </div>
      <p class="mt-5 text-sm text-brand-text/55">{closer.note}</p>
    </div>
  </section>
</BaseLayout>

<script
  is:inline
  define:vars={{ errors }}
>
  const form = document.getElementById("opt-in-form");
  const formError = document.getElementById("form-error");
  const webhookUrl = form.dataset.webhookUrl;

  const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  // US phone: 10 digits, optionally with a leading 1, tolerant of common
  // separators.
  const phoneRe = /^\+?1?[\s.-]?\(?([2-9]\d{2})\)?[\s.-]?(\d{3})[\s.-]?(\d{4})$/;

  function showFieldError(name, message) {
    const el = form.querySelector(`.field-error[data-for="${name}"]`);
    const input = form.elements[name];
    if (el) {
      el.textContent = message;
      el.classList.toggle("hidden", !message);
    }
    if (input && input.setAttribute) {
      if (message) input.setAttribute("aria-invalid", "true");
      else input.removeAttribute("aria-invalid");
    }
  }

  function validate() {
    let firstInvalid = null;
    const check = (name, ok, message) => {
      showFieldError(name, ok ? "" : message);
      if (!ok && !firstInvalid) firstInvalid = form.elements[name];
      return ok;
    };

    const v = (name) => form.elements[name].value.trim();
    let valid = true;
    valid = check("firstName", v("firstName").length > 0, errors.required) && valid;
    valid = check("lastName", v("lastName").length > 0, errors.required) && valid;
    valid =
      check(
        "email",
        v("email").length > 0 && emailRe.test(v("email")),
        v("email").length === 0 ? errors.required : errors.email,
      ) && valid;
    valid =
      check(
        "mobile",
        v("mobile").length > 0 && phoneRe.test(v("mobile")),
        v("mobile").length === 0 ? errors.required : errors.phone,
      ) && valid;
    valid = check("consent", form.elements.consent.checked, errors.consent) && valid;

    if (firstInvalid) firstInvalid.focus();
    return valid;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    formError.classList.add("hidden");
    if (!validate()) return;

    if (!webhookUrl) {
      // PUBLIC_FORM_WEBHOOK_URL is not configured; keep the user's input.
      formError.textContent = errors.submit;
      formError.classList.remove("hidden");
      return;
    }

    const button = form.querySelector('button[type="submit"]');
    button.disabled = true;

    const payload = {
      firstName: form.elements.firstName.value.trim(),
      lastName: form.elements.lastName.value.trim(),
      email: form.elements.email.value.trim(),
      mobile: form.elements.mobile.value.trim(),
      consent: form.elements.consent.checked,
      // Hidden source field so GoHighLevel can attribute the lead.
      source: "free-training-page",
    };

    try {
      const res = await fetch(webhookUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      if (!res.ok) throw new Error(`Webhook responded ${res.status}`);
      window.location.assign("/thank-you");
    } catch (err) {
      // Inline error; the user's input stays in the fields.
      formError.textContent = errors.submit;
      formError.classList.remove("hidden");
      button.disabled = false;
    }
  });
</script>
