---
import { footer, nav, site } from "../copy/shared";
---

<footer id="contact" class="border-t border-brand-text/10 bg-brand-bg">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div>
        <p class="text-lg font-extrabold tracking-tight text-brand-text">
          {site.name}
        </p>
        <p class="mt-1 text-sm text-brand-text/60">{site.company}</p>
      </div>
      <ul class="flex flex-wrap gap-x-8 gap-y-3">
        {
          nav.links.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-brand-text/60 transition-colors hover:text-brand-text"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    {/* Copy rule 7: the compliance paragraph must render exactly as written
        in cmf-launch-landing-page.md. The string lives in src/copy/shared.ts. */}
    <p class="mt-10 max-w-3xl text-xs leading-relaxed text-brand-text/50">
      {footer.compliance}
    </p>

    <p class="mt-6 text-xs text-brand-text/40">&copy; {footer.copyright}</p>
  </div>
</footer>
