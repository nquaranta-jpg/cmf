---
/** Shared section header: optional eyebrow, heading, optional intro line. */
interface Props {
  heading: string;
  eyebrow?: string;
  intro?: string;
  id?: string;
}
const { heading, eyebrow, intro, id } = Astro.props;
---

<div class="mx-auto max-w-3xl text-center" id={id}>
  {eyebrow && <p class="eyebrow justify-center">{eyebrow}</p>}
  <h2
    class="display mt-5 text-3xl text-brand-text sm:text-[2.75rem] sm:leading-[1.05]"
  >
    {heading}
  </h2>
  {intro && <p class="mt-5 text-lg leading-relaxed text-brand-text/65">{intro}</p>}
</div>
