---
/** Accessible FAQ accordion item built on native details/summary. */
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="faq group border-b border-brand-text/10">
  <summary class="flex items-center justify-between gap-4 py-5 text-left text-lg font-semibold text-brand-text">
    <span>{question}</span>
    <svg
      class="faq-chevron h-5 w-5 shrink-0 text-brand-accent"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"></path>
    </svg>
  </summary>
  <div class="pb-5 text-brand-text/70">
    <p>{answer}</p>
  </div>
</details>
