---
/** Accessible FAQ accordion item built on native details/summary. */
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="faq card mb-3 px-6 sm:px-7">
  <summary class="flex items-center justify-between gap-6 py-5 text-left text-base font-semibold text-brand-text sm:text-lg">
    <span>{question}</span>
    <span
      class="faq-chevron grid h-8 w-8 shrink-0 place-content-center rounded-full border border-brand-text/15 text-brand-accent"
      aria-hidden="true"
    >
      <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
        <path d="M8 2v12M2 8h12"></path>
      </svg>
    </span>
  </summary>
  <div class="pb-6 pr-14 leading-relaxed text-brand-text/65">
    <p>{answer}</p>
  </div>
</details>
