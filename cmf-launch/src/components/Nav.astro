---
import CtaButton from "./CtaButton.astro";
import { nav, site } from "../copy/shared";

// TODO: point these at the GoHighLevel portal via env vars before launch.
const loginUrl = import.meta.env.PUBLIC_LOGIN_URL || "#";
const signupUrl = import.meta.env.PUBLIC_SIGNUP_URL || "#";
---

<header class="sticky top-0 z-50 border-b border-brand-text/8 bg-brand-bg/80 backdrop-blur-xl">
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6"
    aria-label="Main"
  >
    <a href="/" class="group flex items-center gap-2.5">
      <span
        class="grid h-8 w-8 place-content-center rounded-lg bg-gradient-to-b from-[var(--gold-bright)] to-[var(--brand-accent)] text-sm font-black text-brand-bg"
        aria-hidden="true"
      >
        C
      </span>
      <span class="text-[1.05rem] font-extrabold tracking-tight text-brand-text">
        {site.name}
      </span>
    </a>

    <ul class="hidden items-center gap-7 md:flex">
      {
        nav.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-sm font-medium text-brand-text/60 transition-colors hover:text-brand-text"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2.5">
      <a
        href={loginUrl}
        class="hidden text-sm font-semibold text-brand-text/60 transition-colors hover:text-brand-text sm:inline-block sm:pr-2"
      >
        {nav.login}
      </a>
      <CtaButton href={signupUrl} size="sm">{nav.signup}</CtaButton>
    </div>
  </nav>
</header>
