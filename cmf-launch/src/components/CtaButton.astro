---
/**
 * Shared CTA button. `variant="primary"` is the gold gradient signup button,
 * `variant="ghost"` is the glassy outlined secondary (e.g. Log In).
 * `size` maps to .btn-sm / default / .btn-lg.
 */
interface Props {
  href: string;
  variant?: "primary" | "ghost";
  size?: "sm" | "md" | "lg";
  class?: string;
}
const { href, variant = "primary", size = "md", class: className = "" } = Astro.props;

const sizeClass = size === "sm" ? "btn-sm" : size === "lg" ? "btn-lg" : "";
const variantClass = variant === "primary" ? "btn-primary" : "btn-ghost";
---

<a href={href} class={`btn ${variantClass} ${sizeClass} ${className}`}><slot /></a>
