{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/mcp/**/*.ts", "src/tasks/**/*.ts", "netlify/functions/mcp.ts", "netlify/functions/tasks-mcp.ts", "netlify/functions/tasks-cron.ts", "tests/**/*.ts"]
}
