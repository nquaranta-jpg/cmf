# SMTP credentials for the OUTREACH inbox — use a secondary domain
# (e.g. cmfpartners.com), NEVER your main domain or personal Gmail.
# For Google Workspace: smtp.gmail.com / 587 / your address / an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

FROM_NAME=Nick Quaranta
FROM_EMAIL=
PHONE=

# Required by CAN-SPAM — a real physical mailing address (PO Box is fine).
POSTAL_ADDRESS=

# Max emails per calendar day. Start at 10 on a fresh inbox, raise weekly.
DAILY_LIMIT=10

# Only needed for netlify-sync.js (running on Netlify instead of locally):
# app.netlify.com > User settings > Applications > Personal access tokens
NETLIFY_AUTH_TOKEN=
