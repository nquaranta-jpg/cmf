# Environment variables for crownmerchantfinancial.com.
# All of these are set in the Netlify dashboard (Site settings > Environment
# variables) — the .env file is only for `npx netlify dev` overrides and is
# gitignored.

# ── Merchants statement analyzer ──
# Anthropic API key used server-side by netlify/functions/merchant-analyzer-background.mjs.
# NEVER exposed client-side.
ANTHROPIC_API_KEY=

# Shared password for the internal review page at /merchants/review.
# Checked in the serverless layer (merchant-review.mjs), never in client code.
MERCHANTS_REVIEW_PASSWORD=

# Email notifications for new statement submissions (optional — Telegram
# notifications work without these). Resend is tried first (RESEND_API_KEY
# is already set in this site's Netlify env); Brevo is the fallback
# provider. The from-address domain must be verified with the provider.
# Recipient defaults to BACKUP_EMAIL (already in Netlify) if
# MERCHANTS_NOTIFY_EMAIL is unset.
BREVO_API_KEY=
MERCHANTS_NOTIFY_EMAIL=
MERCHANTS_NOTIFY_FROM=

# ── Existing site vars (already set in Netlify; listed for reference) ──
# SUPABASE_URL=
# SUPABASE_SERVICE_KEY=
# DASHBOARD_PIN=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GROUP_CHAT_ID=
# TURNSTILE_SECRET_KEY=
# LAUNCH_SESSION_SECRET=
# LAUNCH_DEMO=
